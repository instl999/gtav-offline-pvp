<!--
  Cross-platform build (macOS/Linux/Windows) with the .NET SDK, for contributors without the in-box csc.
  Mirrors build.ps1: .NET Framework 4.8, x64, C# 5.
    dotnet build OfflinePvP.csproj -c Release -p:ShvdnDll=/path/to/ScriptHookVDotNet3.dll
  The DLL lands in bin/ next to the default INIs.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OfflinePvP</AssemblyName>
    <RootNamespace>OfflinePvP</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <NoWarn>612;618</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/</OutputPath>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <None Include="dist/*.ini" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(ShvdnDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Core" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
